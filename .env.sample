# Environment for Trigon tooling. Copy to `.env` and adjust; `env.sh`
# (repo root) loads it — `e2e/run.sh` sources `env.sh` automatically, and
# for direct Python runs: `source ./env.sh && python3 ...`.
# Full reference: README.md "Environment variables".

# --- reference data (ref.py) ---
# Swiss .se1 directory for the pyswisseph cross-check. Default: <repo>/ephe
TRIGON_EPHE_DIR=/path/to/trigon/ephe

# --- E2E suites (e2e/harness.py) ---
# App directory the local suites serve. Default: <repo>/site
E2E_SITE_DIR=/path/to/trigon/site
# Deployed URL verified by the *_live.py scripts. Default: https://trigon.pages.dev
E2E_LIVE_URL=https://trigon.pages.dev
# Chromium executable. Default: Playwright's bundled Chromium
E2E_CHROME_PATH=/path/to/chrome
# 1 = proxy egress through e2e/relay.py (sandboxed VMs). Default: 0
E2E_RELAY=0
# Proxy URL and bypass list, only used when E2E_RELAY=1
E2E_PROXY=http://127.0.0.1:8899
E2E_PROXY_BYPASS=127.0.0.1,localhost
# Extra Chromium args, space-separated. Default: ""
E2E_CHROME_ARGS=
# 1 adds --no-sandbox. Default: auto-added when running as root
E2E_NO_SANDBOX=0
